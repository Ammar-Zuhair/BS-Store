!lib/boosthis-checklist/dist/**
npm-debug.*
yarn-debug.*
yarn-error.*
.metro/
android/
ios/
.DS_Store
Thumbs.db
.agents/
.claude/
.codex/
.minimax/
.secrets/
.uploads/
**/*firebase-adminsdk*.json
**/*service-account*.json
!.env
!google-services.json
