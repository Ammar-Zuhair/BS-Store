{
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "preview",
      "environment": "development"
    },
    "preview": {
      "distribution": "internal",
      "android": { "buildType": "apk" },
      "channel": "preview",
      "environment": "preview"
    },
    "production": {
      "channel": "production",
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "environment": "production",
      "autoIncrement": true
    },
    "production-aab": {
      "extends": "production",
      "distribution": "store",
      "android": { "buildType": "app-bundle" }
    }
  },
  "cli": {
    "appVersionSource": "remote"
  }
}
