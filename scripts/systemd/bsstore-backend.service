[Unit]
Description=BS Store API
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=0

[Service]
Type=exec
WorkingDirectory=/workspace/backend/publish
Environment=DOTNET_ROOT=/workspace/.tools/dotnet
Environment=ASPNETCORE_ENVIRONMENT=Production
ExecStart=/workspace/.tools/dotnet/dotnet /workspace/backend/publish/BSStore.API.dll
Restart=always
RestartSec=5s
TimeoutStopSec=30s

[Install]
WantedBy=multi-user.target
