{
  "name": "ammar-profile",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5173 --strictPort",
    "build": "tsc -b && vite build && node scripts/prerender.mjs",
    "preview": "vite preview --host 0.0.0.0 --port 5173 --strictPort",
    "lint": "eslint .",
    "typecheck": "tsc -b --pretty false",
    "test:e2e": "playwright test",
    "check": "npm run typecheck && npm run lint && npm run build",
    "format": "prettier --write src scripts tests *.ts *.js *.json index.html"
  },
  "dependencies": {
    "@fontsource/tajawal": "^5.3.0",
    "i18next": "^26.5.11",
    "lucide-react": "^1.61.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-i18next": "^17.1.9",
    "react-router": "^8.5.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "lighthouse": "^13.5.0",
    "playwright": "^1.64.1",
    "prettier": "^3.9.10",
    "sharp": "^0.35.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5"
  }
}
