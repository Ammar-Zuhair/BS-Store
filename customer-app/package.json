{
  "name": "customer-app",
  "version": "1.0.0",
  "description": "BS Store Customer App - تطبيق العميل لمتجر BS Store",
  "main": "expo/AppEntry.js",
  "scripts": {
    "postinstall": "node -e \"const fs=require('node:fs');if(fs.existsSync('../scripts/install-expo-cloudflare-cli.js'))require('node:child_process').execFileSync(process.execPath,['../scripts/install-expo-cloudflare-cli.js'],{stdio:'inherit'})\"",
    "start": "expo start --port 8085",
    "tunnel": "EXPO_PORT=8085 bash ../scripts/start-expo-cloudflare-tunnel.sh",
    "android": "expo start --port 8085 --android",
    "ios": "expo start --port 8085 --ios",
    "web": "expo start --port 8085 --web",
    "ts:check": "tsc --noEmit"
  },
  "dependencies": {
    "@expo-google-fonts/tajawal": "^0.4.1",
    "@expo/metro-runtime": "~57.0.16",
    "@expo/ngrok": "^4.1.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@workspace/boosthis-runtime-rn": "file:./lib/boosthis-runtime-rn",
    "boosthis-checklist": "file:./lib/boosthis-checklist",
    "expo": "~57.0.26",
    "expo-application": "~57.0.3",
    "expo-asset": "~57.0.17",
    "expo-constants": "~57.0.18",
    "expo-crypto": "~57.0.3",
    "expo-file-system": "~57.0.7",
    "expo-font": "~57.0.4",
    "expo-image-manipulator": "~57.0.20",
    "expo-image-picker": "~57.0.20",
    "expo-linear-gradient": "~57.0.2",
    "expo-location": "~57.0.20",
    "expo-notifications": "~57.0.18",
    "expo-secure-store": "~57.0.4",
    "expo-status-bar": "~57.0.1",
    "expo-updates": "~57.0.24",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-maps": "1.27.2",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "^0.21.0",
    "react-native-webview": "13.16.1"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "@types/react": "~19.2.0",
    "typescript": "~6.0.3"
  },
  "private": true
}
