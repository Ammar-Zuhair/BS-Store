{
  "expo": {
    "name": "متجر بي اس",
    "owner": "ultra-horizon",
    "slug": "bs-store-customer",
    "version": "1.0.0",
    "extra": {
      "eas": {
        "projectId": "4bddebb7-5c80-4360-b310-dbc00824cd29"
      }
    },
    "sdkVersion": "57.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "يتطلب التطبيق الوصول إلى موقعك الجغرافي لتحديد عنوان التوصيل بدقة وتسهيل استلام طلباتك."
      }
    },
    "android": {
      "package": "com.bsstore.customer",
      "googleServicesFile": "./google-services.json",
      "softwareKeyboardLayoutMode": "resize",
      "permissions": [
        "INTERNET",
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#F4F5F7"
      },
      "config": {
        "googleMaps": {
          "apiKey": "YOUR_ANDROID_MAPS_API_KEY"
        }
      }
    },
    "web": {
      "favicon": "./assets/icon.png"
    },
    "plugins": [
      "expo-asset",
      "expo-font",
      "expo-notifications",
      "./plugins/withFirebaseAndroid"
    ],
    "androidStatusBar": {
      "barStyle": "dark-content",
      "backgroundColor": "#00000000",
      "translucent": true
    }
  }
}
